    "logic": {
      "projectId": "8011063b-1b67-4d60-b696-e29bcd2352a2",
      "blocks": [
        {
          "id": "e450d832-1d00-438e-a336-7472a5b7b102",
          "type": "user-flow",
          "title": "Flujo principal de compra",
          "content": "El usuario ingresa a la vista de Inicio/Tienda y explora el catálogo. Selecciona una camisa y su talla, y hace clic en \"Añadir al carrito\". Luego navega a la Pantalla de Pago, revisa el subtotal y confirma. El frontend envía la petición a la API en Spring Boot, se registra la orden en la base de datos SQL Server y se vacía el carrito del cliente.",
          "status": "defined"
        },
        {
          "id": "4612a58a-ee98-4fa3-993c-591809751730",
          "type": "business-rule",
          "title": "Actualización de inventario",
          "content": "El stock de las camisas solo se reduce en la base de datos de Somee una vez que la orden de compra ha sido confirmada completamente en el checkout. Añadir un producto al carrito no reserva el stock físico, permitiendo que otros usuarios puedan comprarlo si el primer cliente abandona la sesión.",
          "status": "defined"
        },
        {
          "id": "41929194-64a1-4866-8803-8d775bd6d40b",
          "type": "edge-case",
          "title": "Producto agotado durante la compra",
          "content": "Si un cliente tiene una camisa en su carrito, pero otro usuario compra la última unidad disponible antes de que el primer cliente pague, el sistema validará el stock nuevamente al intentar hacer el checkout. Si el stock es 0, mostrará una alerta de \"Stock insuficiente\" y no procesará la orden para ese artículo.",
          "status": "defined"
        }
      ]
    },
    "stack": {
      "projectId": "8011063b-1b67-4d60-b696-e29bcd2352a2",
      "categories": [
        {
          "key": "frontend",
          "label": "stack.category.frontend",
          "choice": "C# con ASP.NET Core (MVC / Web)",
          "justification": "Permite construir interfaces web dinámicas, seguras y escalables utilizando un entorno robusto. Facilita el consumo de servicios RESTful (la API externa) mediante controladores, garantizando una separación clara entre la vista del cliente y la lógica del servidor."
        },
        {
          "key": "backend",
          "label": "stack.category.backend",
          "choice": "Java con Spring Boot",
          "justification": "Proporciona un ecosistema ágil y estructurado para desarrollar la API RESTful. Al utilizar dependencias como Spring Data JPA y el driver de MS SQL Server, permite gestionar de manera eficiente y segura la conexión y el CRUD hacia la base de datos alojada en la plataforma Somee."
        },
        {
          "key": "database",
          "label": "stack.category.database",
          "choice": "SQL Server (Somee)",
          "justification": "Es un motor relacional potente y confiable. Al alojarlo en Somee, aseguramos disponibilidad en la nube para que la API en Spring Boot y el frontend en ASP.NET Core puedan interactuar con el inventario de camisas y los usuarios en tiempo real desde cualquier entorno."
        },
        {
          "key": "auth",
          "label": "stack.category.auth",
          "choice": "JWT (JSON Web Tokens) con Spring Security.",
          "justification": "Permite una autenticación sin estado (stateless) que es ideal y segura para comunicar de forma independiente el frontend en C# con la API RESTful en Java. Garantiza que solo los usuarios y administradores autorizados accedan a sus áreas."
        },
        {
          "key": "infra",
          "label": "stack.category.infra",
          "choice": "Somee (Base de datos) y GitHub (Repositorios).",
          "justification": "Somee ofrece alojamiento en la nube nativo para SQL Server, garantizando que la base de datos esté siempre en línea. GitHub asegura el control de versiones, permitiendo gestionar los proyectos de frontend y backend por separado."
        },
        {
          "key": "services",
          "label": "stack.category.services",
          "choice": "Consumo de API RESTful propia.",
          "justification": "El frontend web no utilizará servicios de terceros complejos, sino que consumirá la API desarrollada internamente en Spring Boot. Esto garantiza control total sobre la lógica de negocio, el flujo de inventario y el procesamiento del carrito."
        },
        {
          "key": "libraries",
          "label": "stack.category.libraries",
          "choice": "Spring Data JPA, MS SQL Server Driver y Lombok.",
          "justification": "El MS SQL Server Driver es indispensable para establecer la conexión con Somee. Spring Data JPA simplifica la interacción con la base de datos (CRUD), y Lombok reduce significativamente el código repetitivo en Java para desarrollar más rápido."
        }
      ]
    },
